{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/meals/:token/",
      "destination": "/api/meal/?token=:token"
    },
    {
      "source": "/marketplace/:id/",
      "destination": "/api/market/?id=:id"
    },
    {
      "source": "/app/:path*/",
      "destination": "/app/"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "headers": [
    {
      "source": "/app/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/firebase-messaging-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "images": {
    "sizes": [
      640,
      1200
    ],
    "domains": [
      "vffncqujwdsvmxjehfgp.supabase.co"
    ],
    "minimumCacheTTL": 86400
  }
}
